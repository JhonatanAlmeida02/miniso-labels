# Cole sua chave da API da Anthropic depois do sinal de igual (sem aspas e sem espaços).
# Crie em: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Gemini (Google) como alternativa ao Claude. Chave em: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# IA que abre selecionada quando as duas estiverem configuradas: claude ou gemini
# Groq (opcional, plano gratuito de limite baixo): console.groq.com -> Chaves API
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
IA_PADRAO=claude

# Acesso de LEITURA ao repositório tiny-erp (necessário se ele for privado).
# Crie em: GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
#   Repository access: Only select repositories -> tiny-erp
#   Permissions: Contents = Read-only   (nada além disso)
GITHUB_TOKEN=

# (Opcional) Memória permanente do Prodiginho. Token Fine-grained SÓ do repositório tiny-agente,
# Permissions: Contents = Read and write. Ele grava só na branch "aprendizado". Nunca use o mesmo do tiny-erp.
GITHUB_TOKEN_ESCRITA=

# (Opcional) Atualizar as bases ao perguntar: dispara os workflows "Sync Produtos" e "Sync Estoque" do tiny-erp.
# Token Fine-grained SÓ do tiny-erp: Actions = Read and write, Contents = Read-only. Os .yml precisam ter workflow_dispatch.
GITHUB_TOKEN_ACTIONS=
# ATUALIZAR_AO_PERGUNTAR=0     (desliga)   ACTION_WORKFLOWS=Sync Produtos,Sync Estoque   ACTION_COOLDOWN_MIN=5
# ACTION_MAX_POR_HORA=20       ACTION_TIMEOUT_S=180

# Código de acesso da equipe. OBRIGATÓRIO ao hospedar na internet; em uso local pode deixar vazio.
CODIGO_ACESSO=

# Opcionais (pode deixar como está):
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Cadeia de modelos (troca sozinho quando o limite do plano gratuito acaba). Padrão já inclui todos abaixo:
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3-flash-preview   (opcional: vai na frente da cadeia)
# PORT=3000

# Fallback SOMENTE para interpretação: Groq e Gemini (nunca Claude pago).
# Só é chamado se as regras locais não entenderem. Off desativa.
# PRODIGINHO_ESCALA=groq,gemini

# Prodiginho: antes das consultas, verifica o histórico do workflow Sync Produtos.
# Se o último sucesso tiver mais de 30 minutos, dispara Sync Produtos e recarrega a base.
# A verificação de histórico é compartilhada e tem cache de 30 segundos.
PRODIGINHO_SYNC_PRODUTOS=1
PRODIGINHO_PRODUTOS_MIN=30
# PRODIGINHO_WORKFLOW_PRODUTOS=Sync Produtos
# PRODIGINHO_CHECK_MS=30000
# PRODIGINHO_RETRY_MS=120000
# O estoque continua sendo sincronizado pelo seu agendamento próprio de 15 minutos.
